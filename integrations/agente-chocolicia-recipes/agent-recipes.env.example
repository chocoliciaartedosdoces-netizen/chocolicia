# URL base do site Chocolícia, usada pelo adaptador para formar o endpoint de geração.
CHOCOLICIA_SITE_URL=
# Token Bearer do endpoint /api/recipes/generate-daily; guardar apenas no ambiente/secret.
CRON_SECRET=
# Permite HTTP somente para testes locais; manter desativado fora do ambiente local.
ALLOW_INSECURE_LOCAL=
