# PostgreSQL/Neon: URL de ligação do servidor à base de dados.
DATABASE_URL=
# Alias opcional de DATABASE_URL usado pelo Drizzle Kit.
NEON_DATABASE_URL=
# Assinatura das sessões administrativas; definir como segredo aleatório forte.
JWT_SECRET=
# Palavra-passe da área administrativa do catálogo.
ADMIN_PASSWORD=
# Identificador opcional da conta administrativa.
ADMIN_OPEN_ID=
# Credenciais S3 do Neon Object Storage para imagens do catálogo e receitas.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Endpoint, região e bucket do armazenamento compatível com S3.
AWS_ENDPOINT_URL_S3=
AWS_REGION=
S3_BUCKET_NAME=
# Porta local do servidor Express.
PORT=
# Token Bearer para publicação de receitas pelo endpoint /api/recipes.
RECIPES_AGENT_TOKEN=
# Token Bearer para o cron e para o endpoint /api/recipes/generate-daily.
CRON_SECRET=
# Controla se receitas geradas são publicadas ou guardadas como rascunhos.
AUTO_PUBLISH=
# Credencial e URL base compatível com a API OpenAI para gerar receitas e imagens.
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Identificadores dos modelos de texto e imagem usados pelo agente.
RECIPES_TEXT_MODEL=
RECIPES_IMAGE_MODEL=
# URL pública/CDN base para servir imagens publicadas de receitas.
RECIPES_PUBLIC_BASE_URL=
